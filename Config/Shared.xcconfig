// Identifiers and signing shared by the app and the widget.
// Neutral defaults: enough for the simulator. For your own values (bundle prefix, team),
// copy Local.xcconfig.example to Local.xcconfig, which git ignores.

BUNDLE_ID_PREFIX = com.example
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// Version shown in the App Store, and build number (set from CI_BUILD_NUMBER on Xcode Cloud).
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// App Group shared by the app, the widget and the shortcuts (snapshot, notification inbox, settings).
APP_GROUP_IDENTIFIER = group.$(BUNDLE_ID_PREFIX).mediatheques-villejuif

#include? "Local.xcconfig"
