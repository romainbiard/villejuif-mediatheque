{
  "sourceLanguage": "fr",
  "strings": {
    "Affiche les prochaines animations des médiathèques.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows upcoming events at the libraries."
          }
        }
      }
    },
    "Affiche votre carte avec son code-barres, luminosité au maximum.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows your card and its barcode, at full brightness."
          }
        }
      }
    },
