    "À rendre depuis le %@. Rapportez-le ou essayez de le prolonger.": {
      "comment": "Notification inbox body for an overdue loan; %@ is the due date (weekday, day, month)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was due on %@. Return it or try renewing it."
          }
        }
      }
    },
    "À retirer à %@. %@": {
      "comment": "Hold ready notification / inbox body; first %@ is the library, second %@ is the status text from the library website (French)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready for pickup at %@. %@"
