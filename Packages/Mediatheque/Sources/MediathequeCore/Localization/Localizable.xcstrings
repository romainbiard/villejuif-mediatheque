    },
    "Reconnectez-vous pour continuer.": {
      "comment": "Error screen message when signed out",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in again to continue."
          }
        }
      }
    },
    "Retour prévu le %@ à %@.": {
      "comment": "Notification inbox body; first %@ is the due date (weekday, day, month), second %@ is the library",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Due back on %@ at %@."
