    "Vous devez rendre %@ %@.": {
      "comment": "Siri summary; first %@ is a quoted title or a document count, second %@ is when (e.g. “today”, “tomorrow, Monday, November 2”)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need to return %@ %@."
          }
        }
      }
    },
    "Vous n'avez aucun prêt en cours.": {
      "comment": "Siri / widget answer when there are no loans",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have no current loans."
          }
        }
      }
    },
    "aujourd'hui": {
      "comment": "Siri summary: due date relative to today",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "today"
          }
        }
      }
    },
    "dans %lld jours, le %@": {
      "comment": "Siri summary: due date; %lld is a number of days (2 or more), %@ is the date (weekday, day, month)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "in %lld days, on %@"
          }
        }
      }
    },
    "demain, le %@": {
      "comment": "Siri summary: due date; %@ is the date (weekday, day, month)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tomorrow, %@"
          }
        }
      }
    },
    "Vérifiez votre connexion, puis réessayez.": {
      "comment": "Error screen message when offline",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection, then try again."
          }
        }
      }
    },
    "« %@ »": {
      "comment": "A document title in quotation marks; %@ is the title",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”"
          }
        }
      }
    },
    "« %@ » est en retard": {
      "comment": "Notification inbox title; %@ is the document title",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is overdue"
          }
        }
      }
    },
    "« %@ » est en retard.": {
      "comment": "Siri summary sentence; %@ is the document title",
