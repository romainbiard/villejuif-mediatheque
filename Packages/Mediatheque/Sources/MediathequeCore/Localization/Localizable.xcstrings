    "Pont de l'Ascension": {
      "comment": "School holiday period name (France, zone C), shown in the agenda",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascension Day long weekend"
          }
        }
      }
