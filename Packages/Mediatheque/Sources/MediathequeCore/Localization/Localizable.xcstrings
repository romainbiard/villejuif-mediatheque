    "Cette semaine dans vos médiathèques": {
      "comment": "Title of the weekly agenda notification (Mondays)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week at your libraries"
          }
        }
      }
    },
    "Connectez-vous dans l'app Médiathèque pour suivre vos prêts.": {
      "comment": "Siri / widget answer when the user is not signed in; Médiathèque is the app name",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to the Médiathèque app to keep track of your loans."
          }
        }
      }
    },
    "Courriel": {
