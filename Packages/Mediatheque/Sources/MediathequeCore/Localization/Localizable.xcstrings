    "Prochain retour : « %@ », %@.": {
      "comment": "Siri summary; first %@ is the document title, second %@ is when (e.g. “today”, “in 3 days, on Thursday, November 5”)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next return: “%@”, %@."
          }
        }
      }
    },
    "Puis %lld autres plus tard.": {
      "comment": "Siri summary, after the next return; number of other loans due later",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Then %lld more later."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Then %lld more later."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Puis %lld autre plus tard."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Puis %lld autres plus tard."
                }
              }
            }
          }
