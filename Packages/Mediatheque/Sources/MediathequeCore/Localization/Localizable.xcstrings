        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is overdue."
          }
        }
      }
    },
    "« %@ » est à rendre aujourd'hui": {
      "comment": "Notification inbox title; %@ is the document title",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is due today"
          }
        }
      }
    },
    "« %@ » est à rendre dans %lld jours": {
      "comment": "Notification inbox title; %@ is the document title, %lld is a number of days (always 2 or more)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is due in %lld days"
          }
        }
      }
    },
    "« %@ » est à rendre demain": {
      "comment": "Notification inbox title; %@ is the document title",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is due tomorrow"
          }
        }
      }
    },
    "« %@ » est à retirer à %@. %@": {
      "comment": "Notification body: document title, pickup library, status text from the website",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is ready for pickup at %@. %@"
          }
        }
      }
    },
    "« %@ » vous attend": {
      "comment": "Notification inbox title for a hold; %@ is the document title",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is ready for pickup"
          }
        }
      }
    },
