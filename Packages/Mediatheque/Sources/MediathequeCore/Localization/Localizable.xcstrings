{
  "sourceLanguage": "fr",
  "strings": {
    "%@ à rendre aujourd'hui. Prolongez-le si vous n'avez pas fini.": {
      "comment": "Return reminder notification body on the due date; %@ is a quoted title or a document count",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ due today. Renew if you're not done yet."
          }
        }
      }
    },
    "%@ à rendre le %@. Vous pouvez prolonger depuis l'app.": {
      "comment": "Return reminder notification body; first %@ is a quoted title or a document count, second %@ is the due date (weekday, day, month)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ due on %@. You can renew from the app."
          }
        }
      }
    },
