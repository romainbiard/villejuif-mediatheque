{
  "sourceLanguage" : "fr",
  "strings" : {
    "%@ · Gratuite" : {
      "comment" : "%@ is the app publisher",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Free"
          }
        }
      }
    },
    "%@ a sa propre app. Installez-la une fois : Ma médiathèque vous y connecte ensuite à chaque fois." : {
      "comment" : "%@ is a service name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has its own app. Install it once: Ma médiathèque will then sign you in every time."
          }
        }
      }
    },
    "%@ est installée" : {
      "comment" : "Banner; %@ is the partner app's name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is installed"
          }
        }
      }
    },
    "%@ n'a pas pu être ouvert. Réessayez dans un instant." : {
      "comment" : "%@ is a service name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ couldn't be opened. Try again in a moment."
          }
        }
      }
    },
    "2 films par mois, musique illimitée" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 films a month, unlimited music"
